**/coverage/
**/.lighthouseci/
**/playwright-report/
**/test-results/

# production
/build
**/dist/
**/out/
*.tgz
/main.js

# misc
.DS_Store
*.pem
*.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

