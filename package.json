{
  "name": "julian",
  "version": "0.4.1",
  "description": "A full-year view for Google Calendar, built for multi-day events.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krmznkr/julian.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @julian/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:run": "turbo run test:run",
    "test:coverage": "turbo run test:coverage",
    "test:tz:dates": "node scripts/test-date-timezones.mjs",
    "test:e2e": "turbo run test:e2e",
    "test:lighthouse": "turbo run test:lighthouse",
    "quality:oxlint": "oxlint --config .oxlintrc.json --react-plugin --react-perf-plugin --jsx-a11y-plugin --vitest-plugin --deny-warnings .",
    "quality:oxfmt": "oxfmt --check \"apps/*/src/**/*.{js,jsx,ts,tsx}\" \"packages/*/src/**/*.ts\" \"apps/*/*.{js,mjs,ts}\" \"infra/**/*.ts\" \"*.{js,mjs,ts}\"",
    "quality:fallow": "fallow dead-code",
    "quality:fp": "eslint .",
    "quality:static": "pnpm run quality:oxlint && pnpm run quality:oxfmt && pnpm run quality:fallow && pnpm run quality:fp && pnpm run typecheck",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "clean:artifacts": "rm -rf apps/*/dist apps/*/coverage packages/*/coverage apps/e2e/playwright-report apps/e2e/test-results apps/e2e/.lighthouseci .turbo **/*.tsbuildinfo"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@types/node": "26.6.5",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.13.0",
    "eslint-plugin-functional": "^10.0.1",
    "fallow": "3.35.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "turbo": "2.11.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt",
      "oxlint --deny-warnings",
      "eslint"
    ]
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "fallow",
      "workerd"
    ],
    "overrides": {
      "@effect/platform-node-shared": "4.0.4",
      "@hono/node-server@<1.19.10": "^1.19.10",
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "esbuild@<0.28.1": "^0.28.1",
      "hono@<4.12.25": "^4.12.25",
      "lodash@<4.18.0": "^4.18.0",
      "sharp@<0.35.5": "^0.35.5",
      "tinypool@<2.1.2": "^2.1.2",
      "undici@<7.30.1": "^7.30.1",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "tmp@<=0.2.3": "0.2.7",
      "uuid@<11.1.1": "11.1.1",
      "tmp@<0.2.7": "0.2.7",
      "valibot@<=1.4.1": "1.4.2",
      "basic-ftp@<=6.2.0": "6.2.1",
      "body-parser@<1.20.9": "^1.20.9",
      "zod@<4.6.6": "^4.6.6",
      "puppeteer-core@24.43.1>@puppeteer/browsers": "3.2.6"
    }
  }
}
