{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "typescript", "oxc", "vitest"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "jsPlugins": ["./scripts/oxlint-functional.mjs"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.turbo/**"
  ],
  "rules": {
    // Sequential awaits are deliberate in the e2e specs and the Effect code.
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    // toSorted/toReversed are ES2023; the packages target ES2022.
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "oxc/no-map-spread": "off",
    "vitest/no-standalone-expect": [
      "warn",
      {
        "additionalTestBlockFunctions": ["it.effect", "it.live", "it.scoped", "it.scopedLive"]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/web/src/**/*.ts",
        "apps/edge/src/**/*.ts",
        "apps/marketing/src/**/*.ts",
        "packages/domain/src/**/*.ts",
        "packages/observability/src/**/*.ts",
        "packages/google/src/**/*.ts",
        "packages/release/src/**/*.ts",
        "infra/src/**/*.ts"
      ],
      "rules": {
        "functional/no-let": "error",
        "functional/no-loop-statements": "error",
        "functional/no-classes": "error",
        "functional/immutable-data": "error"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "functional/no-let": "off",
        "functional/no-loop-statements": "off",
        "functional/immutable-data": "off"
      }
    },
    {
      // Effect requires `class extends` for two of its core declaration forms:
      // tagged errors (`Schema.TaggedErrorClass`) and service keys
      // (`Context.Service`). Both are declaration syntax rather than OO design —
      // no inheritance, no mutable instance state, no methods on the class — so
      // the rule is disabled for the Effect layer only, not the app at large.
      "files": [
        "apps/web/src/lib/effect/*.ts",
        "packages/google/src/**/*.ts",
        "apps/edge/src/errors.ts",
        "apps/edge/src/env.ts"
      ],
      "rules": {
        "functional/no-classes": "off"
      }
    }
  ]
}
