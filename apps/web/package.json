{
  "name": "@julian/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Julian year-view calendar (Foldkit + Effect).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && effect-language-service diagnostics --project tsconfig.json --strict --severity error,warning --format text",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject dist && sentry-cli sourcemaps upload --org krmznkr --project julian --url-prefix '~/' dist"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@floating-ui/dom": "1.8.0",
    "@julian/domain": "workspace:*",
    "@julian/google": "workspace:*",
    "@julian/observability": "workspace:*",
    "@julian/security": "workspace:*",
    "clsx": "2.1.1",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "lucide": "1.70.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@julian/config": "workspace:*",
    "@julian/marketing": "workspace:*",
    "@julian/release": "workspace:*",
    "@sentry/cli": "3.8.2",
    "@tailwindcss/vite": "4.3.4",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.6"
  }
}
