{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["VITE_*", "APP_CHANNEL", "APP_COMMIT", "APP_PR_NUMBER"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:run": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    }
  }
}
