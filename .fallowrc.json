{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "apps/web/public/bootstrap.js",
    "apps/web/src/routes/*.tsx",
    "apps/web/src/test/setup-dom.ts",
    "apps/web/vite.config.ts",
    "apps/web/vitest.config.ts",
    "apps/edge/src/index.ts",
    "apps/edge/vitest.config.ts",
    "apps/marketing/src/styles.css",
    "apps/marketing/vite.config.ts",
    "apps/marketing/vitest.config.ts",
    "packages/*/vitest.config.ts"
  ],
  "ignorePatterns": ["apps/web/index.html", ".github/**"],
  "ignoreDependencies": [
    "pino-pretty",
    "@julian/marketing"
  ]
}
