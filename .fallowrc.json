{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "apps/web/public/bootstrap.js",
    "apps/web/src/foldkit/entry.ts",
    "apps/marketing/src/styles.css",
    "packages/release/src/cli.ts"
  ],
  "supportEntry": [
    "apps/web/src/test/setup-dom.ts",
    "apps/web/vite.config.ts",
    "apps/web/vitest.config.ts",
    "apps/edge/vitest.config.ts",
    "apps/marketing/vite.config.ts",
    "apps/marketing/vitest.config.ts",
    "packages/*/vitest.config.ts",
    "scripts/oxlint-functional.mjs",
    "infra/alchemy.run.ts",
    "infra/scripts/generate-wrangler.ts",
    "infra/vitest.config.ts"
  ],
  "ignorePatterns": [
    "apps/web/index.html",
    ".github/**"
  ],
  "ignoreDependencies": [
    "@julian/marketing",
    "@effect/platform-node"
  ]
}
