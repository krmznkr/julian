{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["VITE_*", "APP_CHANNEL", "APP_COMMIT", "APP_PR_NUMBER"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["JULIAN_SOURCEMAPS"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:run": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["@julian/web#build"],
      "passThroughEnv": ["E2E_PORT"],
      "cache": false
    },
    "test:lighthouse": {
      "dependsOn": ["@julian/web#build"],
      "cache": false
    }
  }
}
